{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "regions": ["gru1"],
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "src/index.ts": {
      "excludeFiles": "{frontend,tests,scripts,database,docs,.local,.superpowers,.impeccable,.vercel}/**"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/entrar", "destination": "/index.html" },
    { "source": "/agenda", "destination": "/index.html" },
    { "source": "/reservas/:id", "destination": "/index.html" }
  ]
}
