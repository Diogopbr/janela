{
  "name": "janela",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.15.0 <25", "npm": ">=11.12.1" },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env src/dev.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p frontend/tsconfig.json",
    "build": "vite build --config frontend/vite.config.ts && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:frontend": "vitest run --config frontend/vitest.config.ts",
    "test:e2e": "playwright test",
    "migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "cleanup": "tsx --env-file-if-exists=.env scripts/cleanup.ts",
    "install-user": "tsx --env-file-if-exists=.env scripts/install-user.ts"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@vercel/functions": "3.9.11",
    "express": "5.3.0",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
